# Copy to .env and fill in.
PORT=3000
# Public URL people use to reach the site (no trailing slash). Must match the
# redirect URI in Google Cloud Console: <BASE_URL>/auth/google/callback
BASE_URL=http://localhost:3000

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: only these Google accounts may sign in (comma-separated). Empty = anyone.
ALLOWED_EMAILS=

# Optional: SQLite file location (default ./data/classcards.db)
# DB_PATH=/var/lib/classcards/classcards.db
